// Prisma schema — the single source of truth for the whole data model.
// See ../../docs/DATABASE.md for a plain-language explanation of every
// table and why it exists.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
}

/// Only GOOGLE is wired up in v1. The field exists on every relevant model
/// so Facebook/Yelp/Trustpilot can be added later without a schema change.
enum Platform {
  GOOGLE
}

enum PlatformAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// Lifecycle of a fetched review's ingestion, independent of its reply.
enum ReviewStatus {
  NEW
  PROCESSING
  PROCESSED
}

enum RiskLevel {
  LOW
  HIGH
}

/// Lifecycle of the AI-generated reply attached to a review.
enum ReplyStatus {
  GENERATED
  PENDING_APPROVAL
  APPROVED
  POSTED
  FAILED
  REJECTED
}

enum NotificationChannel {
  SLACK
  EMAIL
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ── Models ───────────────────────────────────────────────────────────────

/// Staff who log into the dashboard to review/approve replies.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  approvedReplies Reply[] @relation("ApprovedByUser")

  @@map("users")
}

/// A client brand (ACE Training, MultiSkills). Holds the AI reply tone/rules
/// so the same review-processing pipeline can sound different per brand.
model Brand {
  id             String   @id @default(cuid())
  name           String   @unique
  tone           String   @default("Professional, friendly, and concise.")
  language       String   @default("en")
  replyRules     Json?
  forbiddenWords String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  locations        Location[]
  platformAccounts PlatformAccount[]

  @@map("brands")
}

/// A single campus/center that receives reviews.
model Location {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  address   String?
  timezone  String   @default("Australia/Melbourne")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platformLocations PlatformLocation[]
  reviews           Review[]

  @@index([brandId])
  @@map("locations")
}

/// One connected Google Business Profile login for a brand. Tokens are
/// stored encrypted — see backend/src/platform-accounts/token-vault.service.ts,
/// the only file in the codebase that decrypts them.
model PlatformAccount {
  id             String                @id @default(cuid())
  brandId        String
  platform       Platform              @default(GOOGLE)
  accountEmail   String
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime
  status         PlatformAccountStatus @default(CONNECTED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platformLocations PlatformLocation[]

  @@index([brandId])
  @@map("platform_accounts")
}

/// Links one connected PlatformAccount to the external location id(s) it
/// grants access to (a single Google login can cover several campuses).
model PlatformLocation {
  id                 String   @id @default(cuid())
  platformAccountId  String
  locationId         String
  externalLocationId String
  createdAt          DateTime @default(now())

  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([platformAccountId, externalLocationId])
  @@index([locationId])
  @@map("platform_locations")
}

model Review {
  id               String       @id @default(cuid())
  locationId       String
  platform         Platform     @default(GOOGLE)
  externalReviewId String
  reviewerName     String
  rating           Int
  reviewText       String       @default("")
  reviewedAt       DateTime
  fetchedAt        DateTime     @default(now())
  status           ReviewStatus @default(NEW)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  location      Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  analysis      ReviewAnalysis?
  reply         Reply?
  notifications NotificationLog[]

  /// Prevents the same external review from ever being processed twice, and
  /// lets an edited review be found and updated instead of duplicated.
  @@unique([platform, locationId, externalReviewId])
  @@index([locationId])
  @@map("reviews")
}

/// AI sentiment/risk assessment for a review — feeds the auto-post vs
/// needs-approval decision (a 5-star review can still contain a complaint).
model ReviewAnalysis {
  id        String    @id @default(cuid())
  reviewId  String    @unique
  sentiment String
  riskLevel RiskLevel @default(LOW)
  riskFlags String[]  @default([])
  createdAt DateTime  @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_analyses")
}

model Reply {
  id               String      @id @default(cuid())
  reviewId         String      @unique
  aiDraft          String
  finalReply       String?
  status           ReplyStatus @default(GENERATED)
  aiProvider       String
  aiModel          String
  approvedByUserId String?
  postedAt         DateTime?
  platformReplyId  String?
  failureReason    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  review     Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])

  @@map("replies")
}

model NotificationLog {
  id       String              @id @default(cuid())
  reviewId String
  channel  NotificationChannel
  sentAt   DateTime            @default(now())
  status   String
  error    String?

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("notification_logs")
}

/// One row per cron/queue job execution — gives the dashboard and on-call
/// developer something concrete to check for ingestion/posting health.
model JobRunLog {
  id         String    @id @default(cuid())
  jobName    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     JobStatus @default(RUNNING)
  error      String?

  @@index([jobName, startedAt])
  @@map("job_run_logs")
}
